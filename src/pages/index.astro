---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BioTimeline from '../components/BioTimeline.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import Metrics from '../components/Metrics.astro';
import Articles from '../components/Articles.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profileData } from '../data/profile';
---

<Layout
  title={`${profileData.name.th} | เว็บไซต์ประวัติ ผลงานนวัตกรรม และระบบ AI Automation`}
  description={profileData.bioIntro}
>
  <Navbar />
  <main>
    <Hero />
    <BioTimeline />
    <ProjectShowcase />
    <Metrics />
    <Articles />
    <Contact />
  </main>
  <Footer />
</Layout>
