---
import { profileData } from '../data/profile';
---

<section id="articles" class="py-24 bg-white border-t border-[#EAE1D2]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
      <span class="text-xs uppercase tracking-widest text-[#B38B42] font-bold">
        Thought Leadership & Insights
      </span>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900">
        บทความและมุมมองวิสัยทัศน์
      </h2>
      <div class="w-16 h-0.5 bg-[#B38B42] mx-auto"></div>
      <p class="text-stone-600 font-light text-base sm:text-lg">
        แบ่งปันองค์ความรู้ด้านสถาปัตยกรรมซอฟต์แวร์ และประสบการณ์ประยุกต์ใช้ AI ในภาคอุตสาหกรรมจริง
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {profileData.articles.map((article) => (
        <article class="bg-[#FAF8F2] rounded-2xl p-6 sm:p-8 border border-[#EAE1D2] hover:border-[#B38B42] transition-colors flex flex-col justify-between group">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-stone-500">
              <span class="font-semibold text-[#8C6422] uppercase tracking-wider">
                {article.category}
              </span>
              <span>{article.readTime}</span>
            </div>

            <h3 class="text-xl font-serif font-bold text-stone-900 group-hover:text-[#B38B42] transition-colors leading-snug">
              {article.title}
            </h3>

            <p class="text-stone-600 text-sm leading-relaxed font-light">
              {article.summary}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-[#EAE1D2] flex items-center justify-between text-xs text-stone-500">
            <span>{article.date}</span>
            <span class="inline-flex items-center gap-1 font-semibold text-[#143D31] group-hover:translate-x-1 transition-transform">
              อ่านเพิ่มเติม →
            </span>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
