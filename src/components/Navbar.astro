---
import { profileData } from '../data/profile';
---

<header class="sticky top-0 z-50 bg-[#FAF8F2]/95 backdrop-blur-md border-b border-[#EAE1D2]/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo / Monogram -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#B38B42] to-[#8C6422] flex items-center justify-center text-white font-serif font-bold text-lg shadow-sm group-hover:scale-105 transition-transform">
          น
        </div>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-lg tracking-wide text-charcoal-900 group-hover:text-gold-700 transition-colors">
            {profileData.name.th} ({profileData.name.nickname})
          </span>
          <span class="text-[11px] uppercase tracking-wider text-[#8C7E6A] font-medium">
            IT Specialist & AI Automation Architect
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-7">
        <a href="#about" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          ชีวประวัติ
        </a>
        <a href="#experience" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          ประสบการณ์ภาครัฐ
        </a>
        <a href="#credentials" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          วุฒิบัตร & การรับรอง
        </a>
        <a href="#projects" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          ผลงานนวัตกรรม
        </a>
        <a href="#metrics" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          สถิติผลลัพธ์
        </a>
        <a href="#articles" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          บทความ
        </a>
        <a href="#contact" class="text-sm font-medium text-stone-700 hover:text-gold-700 transition-colors">
          ติดต่อ
        </a>
      </nav>

      <!-- Action Button -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="tel:0819265159"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold text-stone-700 bg-white border border-[#D9CEBA] hover:border-[#B38B42] transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-[#143D31]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          081-926-5159
        </a>
        <a
          href="#contact"
          class="inline-flex items-center px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase bg-[#143D31] text-white hover:bg-[#0F2E24] shadow-sm hover:shadow transition-all"
        >
          นัดหมาย / ร่วมงาน
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden inline-flex items-center justify-center p-2 rounded-lg text-stone-700 hover:text-gold-700 focus:outline-none"
        aria-label="Toggle navigation menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#FAF8F2] border-b border-[#EAE1D2] px-4 pt-2 pb-6 space-y-3">
    <a href="#about" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">ชีวประวัติ</a>
    <a href="#experience" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">ประสบการณ์ภาครัฐ</a>
    <a href="#credentials" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">วุฒิบัตร & การรับรอง</a>
    <a href="#projects" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">ผลงานนวัตกรรม</a>
    <a href="#metrics" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">สถิติผลลัพธ์</a>
    <a href="#articles" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">บทความ</a>
    <a href="#contact" class="block text-base font-medium text-stone-800 hover:text-gold-700 py-1">ติดต่อ</a>
    <div class="pt-2 flex flex-col gap-2">
      <a href="tel:0819265159" class="text-center py-2 rounded-full text-xs font-semibold text-stone-800 bg-white border border-[#D9CEBA]">
        โทร: 081-926-5159
      </a>
      <a href="#contact" class="text-center py-2.5 rounded-full text-xs font-semibold tracking-wider uppercase bg-[#143D31] text-white">
        นัดหมาย / ร่วมงาน
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
