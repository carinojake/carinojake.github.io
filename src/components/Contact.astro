---
import { profileData } from '../data/profile';
---

<section id="contact" class="py-24 bg-[#FAF8F2] border-t border-[#EAE1D2]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <span class="text-xs uppercase tracking-widest text-[#B38B42] font-bold">
        Official Contact & Engagement
      </span>
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900">
        ช่องทางติดต่อและประสานงาน
      </h2>
      <div class="w-16 h-0.5 bg-[#B38B42] mx-auto"></div>
      <p class="text-stone-600 font-light leading-relaxed text-sm sm:text-base">
        พร้อมนำศักยภาพ ความเชี่ยวชาญด้านระบบสารสนเทศ และพลังใจที่ไม่ยอมแพ้ เข้าร่วมปฏิบัติหน้าที่และขับเคลื่อนภารกิจอย่างเต็มกำลังความสามารถ
      </p>
    </div>

    <!-- Contact Cards Grid (Centered & Balanced Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Telephone -->
      <div class="bg-white p-7 rounded-2xl border border-[#EAE1D2] shadow-sm hover:shadow-md transition-shadow text-center flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-full bg-[#FAF5EC] text-[#143D31] flex items-center justify-center mx-auto shadow-2xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-stone-500 font-medium">หมายเลขโทรศัพท์</div>
            <a href={`tel:${profileData.contact.phone}`} class="text-lg font-serif font-bold text-stone-900 hover:text-gold-700 block mt-1">
              {profileData.contact.phone}
            </a>
          </div>
        </div>
        <a
          href={`tel:${profileData.contact.phone}`}
          class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl bg-stone-50 hover:bg-[#143D31] text-stone-700 hover:text-white border border-stone-200 text-xs font-semibold transition-colors"
        >
          โทรติดต่อโดยตรง
        </a>
      </div>

      <!-- Card 2: Email -->
      <div class="bg-white p-7 rounded-2xl border border-[#EAE1D2] shadow-sm hover:shadow-md transition-shadow text-center flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-full bg-[#FAF5EC] text-[#8C6422] flex items-center justify-center mx-auto shadow-2xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-stone-500 font-medium">ไปรษณีย์อิเล็กทรอนิกส์ (อีเมล)</div>
            <a href={`mailto:${profileData.contact.email}`} class="text-sm font-semibold text-stone-900 hover:text-gold-700 block mt-1 break-all">
              {profileData.contact.email}
            </a>
            <div class="text-[11px] text-stone-400 mt-0.5">
              สำรอง: <a href={`mailto:${profileData.contact.emailAlt}`} class="hover:text-gold-700">{profileData.contact.emailAlt}</a>
            </div>
          </div>
        </div>
        <a
          href={`mailto:${profileData.contact.email}`}
          class="inline-flex items-center justify-center gap-1.5 w-full py-2.5 rounded-xl bg-stone-50 hover:bg-[#8C6422] text-stone-700 hover:text-white border border-stone-200 text-xs font-semibold transition-colors"
        >
          ส่งอีเมลติดต่อ
        </a>
      </div>

      <!-- Card 3: Location & Work Mode -->
      <div class="bg-white p-7 rounded-2xl border border-[#EAE1D2] shadow-sm hover:shadow-md transition-shadow text-center flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-full bg-[#FAF5EC] text-stone-700 flex items-center justify-center mx-auto shadow-2xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <div class="text-xs text-stone-500 font-medium">ที่อยู่และรูปแบบการปฏิบัติงาน</div>
            <div class="text-sm font-semibold text-stone-900 mt-1">{profileData.contact.location}</div>
            <div class="text-[11px] text-stone-500 mt-1 leading-snug">{profileData.contact.workMode}</div>
          </div>
        </div>
        <div class="py-2.5 px-3 rounded-xl bg-emerald-50 text-emerald-800 text-[11px] font-semibold border border-emerald-200 flex items-center justify-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          พร้อมปฏิบัติงาน (WFH / รัฐสภา)
        </div>
      </div>

    </div>

  </div>
</section>
